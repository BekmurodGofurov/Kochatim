VITE_API_BASE_URL=http://localhost:8000

# Must equal WEB_CLIENT_KEY in backend/.env. It ends up in the browser
# bundle, so it identifies the app; it is not a secret and protects no user
# data by itself. Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# On Cloudflare Pages set it as an environment variable of the same name.
VITE_CLIENT_KEY=change_me
VITE_TG_BOT_USERNAME=your_bot_username
