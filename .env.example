# Used by docker-compose to provision the local Postgres container.
POSTGRES_USER=kochatim
POSTGRES_PASSWORD=change_me
POSTGRES_DB=kochatim

# Backend API manzili (server IP yoki domen + port, oxirida "/" siz).
# Client shu manzil orqali API'ga murojaat qiladi; backend/.env dagi ALLOWED_ORIGINS ga client manzilini qo'shing.
PUBLIC_URL=http://localhost:8000
