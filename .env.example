# Used by docker-compose to provision the local Postgres container.
POSTGRES_USER=kochatim
POSTGRES_PASSWORD=change_me
POSTGRES_DB=kochatim

# Only used by the `client` container, which runs under the "local"
# profile. In production the frontend is built by Cloudflare Pages and
# this value is set there as VITE_API_BASE_URL instead.
#
# Vite inlines it at BUILD time, so changing it needs a rebuild:
#   docker compose --profile local up -d --build client
PUBLIC_URL=http://localhost:8000
