# In docker-compose, host "db" is the local Postgres container;
# credentials must match the root .env (POSTGRES_USER/PASSWORD/DB).
DATABASE_URL="postgresql://kochatim:change_me@db:5432/kochatim"

# Bot <-> backend shared secret (X-API-KEY). Secret: never put it in the client.
API_KEY=change_me

# Identifies the web client (X-Client-Key). Must differ from API_KEY, and must
# equal VITE_CLIENT_KEY in client/.env / the Cloudflare Pages environment.
# It is baked into the browser bundle, so treat it as public.
# A production backend refuses to start if either key is empty, equal to the
# other, or still "change_me".
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
WEB_CLIENT_KEY=change_me

# Signs partner-invite links. Optional; defaults to API_KEY. Set it (to any
# long random value) before you ever rotate API_KEY, otherwise every invite
# link already sent stops working at the moment of rotation.
# INVITE_SECRET=

# Peers whose X-Real-IP header is believed (comma-separated IPs / CIDRs):
# the host nginx, arriving over loopback or the Docker bridge gateway.
# Any other peer is identified by its TCP address; X-Forwarded-For is never read.
TRUSTED_PROXIES=127.0.0.1,::1,172.16.0.0/12

# Seconds a Telegram Mini App initData stays valid for login (replay window).
INITDATA_MAX_AGE_SECONDS=3600
# Seconds a per-request device proof is accepted (clock skew allowed).
PROOF_MAX_SKEW_SECONDS=60

BOT_TOKEN="your_telegram_bot_token"
TG_BOT_USERNAME=your_bot_username

FLASK_ENV=production
PORT=8000
OTP_TTL_SECONDS=120
SESSION_TTL_SECONDS=2592000
DB_POOL_MIN=5
# PER WORKER, and gunicorn runs 4 — so this is really 4x this number of
# connections against Postgres's default max_connections of 100.
DB_POOL_MAX=20
IMGBB_API_KEY="your_imgbb_api_key"

# Exact origins, comma-separated. An EMPTY value rejects every browser
# request — there is no wildcard fallback.
# Production (frontend on Cloudflare Pages):
#   ALLOWED_ORIGINS=https://kochatim.uz,https://www.kochatim.uz
ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:5174

# In docker-compose, host "redis" is the local Redis container.
REDIS_HOST="redis"
REDIS_PORT=6379
REDIS_PASSWORD=""
SERVER_NAME=server
