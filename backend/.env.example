# In docker-compose, host "db" is the local Postgres container;
# credentials must match the root .env (POSTGRES_USER/PASSWORD/DB).
DATABASE_URL="postgresql://kochatim:change_me@db:5432/kochatim"

API_KEY=change_me

BOT_TOKEN="your_telegram_bot_token"
TG_BOT_USERNAME=your_bot_username

FLASK_ENV=production
PORT=8000
OTP_TTL_SECONDS=120
SESSION_TTL_SECONDS=2592000
DB_POOL_MIN=5
# PER WORKER, and gunicorn runs 4 — so this is really 4x this number of
# connections against Postgres's default max_connections of 100.
DB_POOL_MAX=20
IMGBB_API_KEY="your_imgbb_api_key"

# Exact origins, comma-separated. An EMPTY value rejects every browser
# request — there is no wildcard fallback.
# Production (frontend on Cloudflare Pages):
#   ALLOWED_ORIGINS=https://kochatim.uz,https://www.kochatim.uz
ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:5174

# In docker-compose, host "redis" is the local Redis container.
REDIS_HOST="redis"
REDIS_PORT=6379
REDIS_PASSWORD=""
SERVER_NAME=server
