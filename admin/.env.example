# In docker-compose, host "redis" is the local Redis container.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Nginx log parsing (worker IP addresses) — only relevant when this
# service is deployed on the real Nginx load-balancer host.
WORKER_1_IP=172.26.3.174
WORKER_1_NAME=Server 1

WORKER_2_IP=172.26.10.95
WORKER_2_NAME=Server 2

PORT=9000
