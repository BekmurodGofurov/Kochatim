# In docker-compose, host "redis" is the local Redis container.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

PORT=9000

# HTTP Basic credentials for the panel and its live feed. REQUIRED: with
# either one empty the panel answers 503 to everything (fail closed).
ADMIN_USER=admin
ADMIN_PASSWORD=change_me
# Extra origins allowed to open the live-feed WebSocket (comma-separated).
# Leave empty for same-origin only, which is what you want.
# ADMIN_ALLOWED_ORIGINS=
